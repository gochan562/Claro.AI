# Claro.AI environment variables
# Copy this file to .env and fill in real values. Never commit .env with secrets.

# Server
PORT=5000
SESSION_SECRET=change-me-to-a-long-random-string
# Comma-separated list of allowed frontend origins for CORS (e.g. https://your-domain.com,http://localhost:5000)
FRONTEND_ORIGIN=http://localhost:5000

# Training
TRAINING_PROVIDER=local
PYTHON_BIN=python3

# GPU / Modal
GPU_PROVIDER=zerogpu
ZEROGPU_SPACE=Gochan562/claro_ai_gpu
MODAL_RUN_URL=
MODAL_STREAM_URL=
MODAL_AUTH_SECRET=

# Hugging Face
HF_TOKEN=
