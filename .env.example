# Claro.AI environment variables
# Copy this file to .env and fill in real values. Never commit .env with secrets.

# Server
PORT=5000
# Comma-separated list of allowed frontend origins for CORS (e.g. https://your-domain.com,http://localhost:5000)
FRONTEND_ORIGIN=http://localhost:5000

# Training
TRAINING_PROVIDER=local
PYTHON_BIN=python3

# GPU / Modal
GPU_PROVIDER=zerogpu
ZEROGPU_SPACE=Gochan562/claro_ai_gpu
# ZeroGPU remote training (Training Cell with TRAINING_PROVIDER=zerogpu runs
# training_runner.py on the Space via its structured /train endpoint):
# Full endpoint base override (default: https://<space>.hf.space/gradio_api)
ZEROGPU_TRAIN_API=
# Overall per-job timeout for a remote training call (default: max_time_sec + 180s)
ZEROGPU_TRAIN_TIMEOUT_MS=
# Bearer token if the Space is private (never exposed to the browser)
ZEROGPU_API_TOKEN=
# Max accepted artifact download size in bytes (default 2000000000)
ZEROGPU_TRAIN_MAX_ARTIFACT_BYTES=
MODAL_RUN_URL=
MODAL_STREAM_URL=
MODAL_AUTH_SECRET=

# Hugging Face
HF_TOKEN=
